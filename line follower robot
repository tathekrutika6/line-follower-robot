#include <stdio.h>
#include <time.h>

void delay(int milliseconds)
{
    clock_t start = clock();

    while ((clock() - start) * 1000 / CLOCKS_PER_SEC
           < milliseconds);
}

void gotoxy(int row, int col)
{
    printf("\033[%d;%dH", row, col);
}

int main()
{
    int i, j;

    printf("\033[?25l");  // Hide cursor

    for (i = 6; i <= 20; i++)
    {
        printf("\033[2J");  // Clear screen
        printf("\033[H");

        // Title
        gotoxy(1, 37);
        printf("\033[1;33mLINE FOLLOWER ROBOT\033[0m");

        // Start and End
        gotoxy(3, 13);
        printf("\033[1;32mSTART\033[0m");

        gotoxy(3, 78);
        printf("\033[1;32mEND\033[0m");

        // Side boundaries
        for (j = 5; j <= 24; j++)
        {
            gotoxy(j, 10);
            printf("\033[1;32m|\033[0m");

            gotoxy(j, 90);
            printf("\033[1;32m|\033[0m");
        }

        // Line/path
        for (j = i + 3; j <= 24; j++)
        {
            gotoxy(j, 50);
            printf("\033[1;37m#\033[0m");
        }

        // Robot
        gotoxy(i, 42);
        printf("\033[1;36m___________");

        gotoxy(i + 1, 42);
        printf("|  ROBOT  |");

        gotoxy(i + 2, 42);
        printf("O---------O\033[0m");

        // Bottom message
        gotoxy(27, 10);
        printf("\033[1;33mRobot moving from START to END...\033[0m");

        fflush(stdout);

        delay(250);
    }

    // Final screen
    printf("\033[2J");
    printf("\033[H");

    gotoxy(1, 37);
    printf("\033[1;33mLINE FOLLOWER ROBOT\033[0m");

    gotoxy(3, 13);
    printf("\033[1;32mSTART\033[0m");

    gotoxy(3, 78);
    printf("\033[1;32mEND\033[0m");

    for (j = 5; j <= 24; j++)
    {
        gotoxy(j, 10);
        printf("\033[1;32m|\033[0m");

        gotoxy(j, 90);
        printf("\033[1;32m|\033[0m");
    }

    gotoxy(20, 42);
    printf("\033[1;36m___________");

    gotoxy(21, 42);
    printf("|  ROBOT  |");

    gotoxy(22, 42);
    printf("O---------O\033[0m");

    gotoxy(27, 10);
    printf("\033[1;32mRobot reached END successfully!\033[0m");

    gotoxy(29, 1);
    printf("\033[?25h");

    return 0;
}
